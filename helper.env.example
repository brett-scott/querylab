# Local helper configuration. Copy with scripts/setup-helper.ps1.
# Keep the generated .env.helper private. These values are never hosted assets.
QUERYLAB_HELPER_MODE=true
QUERYLAB_PAIRING_TOKEN=generate-a-local-pairing-code
QUERYLAB_WORKSPACE_NAMESPACE=generate-a-local-namespace
QUERYLAB_HELPER_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:5173,http://localhost:5173
QUERYLAB_HELPER_PORT=8765
QUERYLAB_HELPER_PREVIEW_PORT=8081
QUERYLAB_SESSION_TTL_SECONDS=3600
QUERYLAB_MAX_SESSIONS=10
QUERYLAB_SQL_TIMEOUT_SECONDS=8
# Bundled: mysql. Existing Windows/macOS host through Docker: host.docker.internal.
# Native Python helper connecting to local MySQL: 127.0.0.1.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=replace-with-your-local-mysql-password

